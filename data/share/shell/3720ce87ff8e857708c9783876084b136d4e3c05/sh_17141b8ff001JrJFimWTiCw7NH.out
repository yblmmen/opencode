const $=s=>document.querySelector(s), num=(v,d=2)=>v==null?'M-bM-^@M-^T':Number(v).toLocaleString('ko-KR',{maximumFractionDigits:d}), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&','<':'<','>':'>','"':'"',"'":'''}[c]));$
const time=s=>s?new Date(s).toLocaleString('ko-KR',{timeZone:'Asia/Seoul',hour12:false}):'M-jM-8M-0M-lM-$M-^@M-lM-^KM-^\M-jM-0M-^A M-kM-/M-8M-lM- M-^\M-jM-3M-5';$
const sign=v=>v>0?'up':v<0?'down':'';$
const pct=v=>v==null?'M-bM-^@M-^T':(v>0?'+':'')+Number(v).toFixed(2)+'%';$
const API=async(path,options={})=>{const r=await fetch(path,options);let d=await r.json();if(!r.ok)throw Error(d.detail||d.error||r.status);return d};$
let flowSeq=0,busy=false,chatHistory=[];$
const baseLayout={paper_bgcolor:'transparent',plot_bgcolor:'transparent',font:{color:'#8c9caf',size:11},margin:{l:58,r:20,t:15,b:35},showlegend:false,xaxis:{gridcolor:'#202d3f',rangeslider:{visible:false}},yaxis:{gridcolor:'#202d3f',side:'right'},hovermode:'x unified'};$
const config={responsive:true,displaylogo:false,modeBarButtonsToRemove:['lasso2d','select2d']};$
function notice(d){return [d.stale?'M-bM-^ZM-  M-lM-^]M-4M-lM- M-^D M-kM-^MM-0M-lM-^]M-4M-mM-^DM-0 / M-jM-0M-1M-lM-^KM-  M-lM-^KM-$M-mM-^LM-(':'',d.error||'',d.fetched_at?'M-lM-!M-0M-mM-^ZM-^L '+time(d.fetched_at):'M-lM-!M-0M-mM-^ZM-^LM-kM-^PM-^XM-lM-'M-^@ M-lM-^UM-^JM-lM-^]M-^L'].filter(Boolean).join(' M-BM-7 ')}$
$
async function loadMarkets(){$
 const items=await API('/api/market'),box=$('#markets');box.replaceChildren();$
 for(const x of items){$
  const b=document.createElement('div');b.className='market'+(x.stale?' stale':'');b.tabIndex=0;b.role='button';$
  const d=x.data;b.innerHTML=`<div class="name">${esc(x.name)}</div><div class="value">${num(d?.price)}<span class="unit">${esc(x.unit)}</span></div><div class="meta">${esc(d?.source||x.source)} M-BM-7 ${d?.delayed?'M-lM-'M-^@M-lM-^WM-0 M-jM-0M-^@M-kM-^JM-%':'1M-kM-6M-^D M-lM-!M-0M-mM-^ZM-^L'}<br>${esc(time(d?.as_of))}</div><div class="meta ${x.stale?'error':''}">${esc(notice(x))}</div>`;$
  b.onkeydown=e=>{if(e.key==='Enter')b.click()};box.append(b);$
 }$
}$
