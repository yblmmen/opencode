timestamp=2026-10-10T01:33:12.965Z level=INFO run=89060fcb message="spawning process" command=/bin/bash args="[\"-c\",\"cat > /workspace/toss/app/static/app.js << 'EOF'\\nconst $=s=>document.querySelector(s), num=(v,d=2)=>v==null?'—':Number(v).toLocaleString('ko-KR',{maximumFractionDigits:d}), esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&','<':'<','>':'>','\\\"':'\\\"',\\\"'\\\":'''}[c]));\\nconst time=s=>s?new Date(s).toLocaleString('ko-KR',{timeZone:'Asia/Seoul',hour12:false}):'기준시각 미제공';\\nconst sign=v=>v>0?'up':v<0?'down':'';\\nconst API=async(path,options={})=>{const r=await fetch(path,options);let d=await r.json();if(!r.ok)throw Error(d.detail||d.error||r.status);return d};\\nlet selected='^IXIC',selectedName='나스닥 종합',period='5m',chartSeq=0,flowSeq=0,busy=false,chatHistory=[];\\nconst baseLayout={paper_bgcolor:'transparent',plot_bgcolor:'transparent',font:{color:'#8c9caf',size:11},margin:{l:58,r:20,t:15,b:35},showlegend:false,xaxis:{gridcolor:'#202d3f',rangeslider:{visible:false}},yaxis:{gridcolor:'#202d3f',side:'right'},hovermode:'x unified'};\\nconst config={responsive:true,displaylogo:false,modeBarButtonsToRemove:['lasso2d','select2d']};\\nfunction maLabels(interval){return interval===\\\"1d\\\"?[\\\"MA 5일\\\",\\\"MA 20일\\\",\\\"MA 60일\\\",\\\"MA 240일\\\"]:[\\\"MA 5봉\\\",\\\"MA 20봉\\\",\\\"MA 60봉\\\",\\\"MA 120봉\\\"];}\\nfunction maPeriods(interval){return interval===\\\"1d\\\"?[5,20,60,240]:[5,20,60,120];}\\nfunction notice(d){return [d.stale?'⚠ 이전 데이터 / 갱신 실패':'',d.error||'',d.fetched_at?'조회 '+time(d.fetched_at):'조회되지 않음'].filter(Boolean).join(' · ')}\\nfunction spark(rows){let vals=rows.slice(-40).map(r=>r.close).filter(v=>v!=null);if(vals.length<2)return '';let lo=Math.min(...vals),hi=Math.max(...vals),diff=hi-lo||1;return '<svg viewBox=\\\"0 0 220 37\\\" preserveAspectRatio=\\\"none\\\" aria-hidden=\\\"true\\\"><polyline fill=\\\"none\\\" stroke=\\\"#5de0ba\\\" stroke-width=\\\"1.5\\\" points=\\\"'+vals.map((v,i)=>`${i*220/(vals.length-1)},${34-(v-lo)/diff*30}`).join(' ')+'\\\"/></svg>'}\\nasync function loadMarkets(){\\n const items=await API('/api/market'),box=$('#markets');box.replaceChildren();\\n for(const x of items){const b=document.createElement('div');b.className='market'+(x.symbol===selected?' selected':'');b.tabIndex=0;b.role='button';\\n const d=x.data;b.innerHTML=`<div class=\\\"name\\\">${esc(x.name)}</div><div class=\\\"value\\\">${num(d?.price)}<span class=\\\"unit\\\">${esc(x.unit)}</span></div><div class=\\\"spark\\\"></div><div class=\\\"meta\\\">${esc(d?.source||x.source)} · ${d?.delayed?'지연 가능':'1분 조회'}<br>${esc(time(d?.as_of))}</div><div class=\\\"meta ${x.stale?'error':''}\\\">${esc(notice(x))}</div>`;\\n b.onclick=()=>select(x.symbol,x.name);b.onkeydown=e=>{if(e.key==='Enter')b.click()};box.append(b);\\n API('/api/chart?symbol='+encodeURIComponent(x.symbol)+'&interval=1d').then(c=>{if(c.data)b.querySelector('.spark').innerHTML=spark(c.data.rows);}).catch(()=>{});\\n }\\n}\\nasync function select(symbol,name){selected=symbol;selectedName=name;$('#chart-title').textContent=name;$('#search-results').replaceChildren();await loadChart()}\\nasync function loadChart(){\\n const seq=++chartSeq,sym=selected,p=period;\\n $('#chart-note').textContent='차트 조회 중…';\\n try{\\n const [d,q]=await Promise.all([API('/api/chart?symbol='+encodeURIComponent(sym)+'&interval='+p),API('/api/quote?symbol='+encodeURIComponent(sym))]);if(seq!==chartSeq)return;\\n $('#quote').innerHTML=`${num(q.data?.price)} <small>${esc(q.data?.currency||'')} · ${esc(time(q.data?.as_of))} · ${esc(notice(q))}</small>`;\\n $('#chart-note').textContent=notice(d)+(d.data?' · '+d.data.source+' · '+d.data.note:'');\\n if(!d.data){Plotly.purge('price-chart');return}\\n const rows=d.data.rows,x=rows.map(r=>r.date),traces=[{type:'candlestick',name:'가격',x,open:rows.map(r=>r.open),high:rows.map(r=>r.high),low:rows.map(r=>r.low),close:rows.map(r=>r.close),increasing:{line:{color:'#ff777d'}},decreasing:{line:{color:'#79a9ff'}}}];\\n maPeriods(p).forEach((n,i)=>traces.push({type:'scatter',mode:'lines',name:maLabels(p)[i],x,y:rows.map(r=>r['ma'+n]),line:{color:['#64d9ba','#efc775','#91a2ff','#e091cc'][i],width:1},connectgaps:false}));\\n traces.push({type:'bar',name:'거래량',x,y:rows.map(r=>r.volume),yaxis:'y2',marker:{color:rows.map(r=>r.close>=r.open?'#91505e':'#405e8c')}});\\n const isMinute=p!==\\\"1d\\\";\\n Plotly.react('price-chart',traces,{...baseLayout,uirevision:sym+':'+p,xaxis:{...baseLayout.xaxis,type:isMinute?'category':'date',range:isMinute?undefined:[x[Math.max(0,x.length-130)],x.at(-1)]},yaxis:{...baseLayout.yaxis,domain:[.26,1]},yaxis2:{gridcolor:'#202d3f',domain:[0,.17],side:'right',title:{text:'거래량',font:{size:10}}}},config);\\n }catch(e){if(seq===chartSeq)$('#chart-note').textContent=e.message}\\n}\\nasync function loadFlows(){\\n const seq=++flowSeq;\\n const d=await API('/api/flows?market='+$('#flow-market').value+'&interval='+$('#flow-period').value);if(seq!==flowSeq)return;\\n $('#flow-note').textContent=notice(d)+(d.data?' · '+d.data.note:'');\\n if(!d.data){$('#flow-cards').replaceChildren();Plotly.purge('flow-chart');return}\\n const rows=d.data.rows,last=rows.at(-1),keys=['foreigner','institution','individual'],names=['외국인','기관','개인'],colors=['#5de0ba','#91a2ff','#efc775'];\\n $('#flow-cards').innerHTML=keys.map((k,i)=>`<div><small>${names[i]} 순매수 · 억원</small><strong class=\\\"${sign(last?.[k])}\\\">${num(last?.[k])}</strong><small>${esc(last?.date||'데이터 없음')}</small></div>`).join('');\\n $('#flow-note').textContent+=' · 공급원 갱신 '+time(last?.updated_at);\\n Plotly.react('flow-chart',keys.map((k,i)=>({type:'bar',name:names[i],x:rows.map(r=>r.date),y:rows.map(r=>r[k]),marker:{color:colors[i]}})),{...baseLayout,barmode:'group',showlegend:true,legend:{orientation:'h',y:1.18},yaxis:{...baseLayout.yaxis,title:{text:'억원'}},uirevision:$('#flow-market').value+$('#flow-period').value},config);\\n}\\nasync function loadHoldings(){\\n const d=await API('/api/holdings');$('#holdings-note').textContent=notice(d)+(d.data?' · '+d.data.note:'');\\n const body=$('#holdings');body.replaceChildren();\\n if(!d.data?.items?.length){body.innerHTML='<tr><td colspan=\\\"8\\\">'+esc(d.data?'보유종목이 없습니다.':d.error||'조회 실패')+'</td></tr>';return}\\n for(const x of d.data.items){const r=document.createElement('tr');r.innerHTML=`<td><strong>${esc(x.name)}</strong><small>${esc(x.symbol)} · ${esc(x.account)}</small></td><td>${esc(x.currency)}</td><td>${num(x.quantity,6)}</td><td>${num(x.price)}</td><td>${num(x.value)}</td><td class=\\\"${sign(x.pnl)}\\\">${num(x.pnl)}</td><td class=\\\"${sign(x.daily_pnl)}\\\">${num(x.daily_pnl)}</td><td class=\\\"${sign(x.return_pct)}\\\">${num(x.return_pct)}%</td>`;r.cells[0].onclick=()=>select(x.symbol,x.name);body.append(r)}\\n}\\n$('#search-form').onsubmit=async e=>{e.preventDefault();const q=$('#search-input').value.trim();if(!q)return;$('#search-results').textContent='종목 목록 검색 중… 최초 검색은 시간이 걸릴 수 있습니다.';\\n try{const d=await API('/api/search?q='+encodeURIComponent(q));$('#search-results').replaceChildren();for(const x of d.items){const b=document.createElement('button');b.textContent=x.name+' · '+x.symbol+' / '+x.market;b.onclick=()=>select(x.symbol,x.name);$('#search-results').append(b)}if(!d.items.length)$('#search-results').textContent='검색 결과 없음';if(d.errors.length){const s=document.createElement('small');s.textContent='일부 시장 목록 조회 실패. API 상태를 확인하세요.';$('#search-results').append(s)}}catch(e){$('#search-results').textContent=e.message}};\\n$('#periods').onclick=e=>{if(!e.target.dataset.period)return;period=e.target.dataset.period;document.querySelectorAll('#periods button').forEach(b=>b.classList.toggle('active',b===e.target));loadChart()};\\n$('#flow-market').onchange=$('#flow-period').onchange=()=>loadFlows().catch(e=>$('#flow-note').textContent=e.message);\\nfunction bubble(text,role){const b=document.createElement('div');b.className='bubble '+role;b.textContent=text;$('#messages').append(b);$('#messages').scrollTop=$('#messages').scrollHeight;return b}\\n$('#chat-form').onsubmit=async e=>{e.preventDefault();const prompt=$('#prompt').value.trim();if(!prompt||$('#send').disabled)return;bubble(prompt,'user');$('#prompt').value='';$('#send').disabled=true;const b=bubble('조회 도구로 데이터를 확인하고 있습니다…','bot');\\n try{const r=await API('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt,history:chatHistory.slice(-10)})});b.textContent=r.answer||'답변 없음';chatHistory.push({role:'user',content:prompt},{role:'assistant',content:r.answer||''})}catch(e){b.textContent=e.message}finally{$('#send').disabled=false}};\\ndocument.querySelectorAll('.suggestions button').forEach(b=>b.onclick=()=>{$('#prompt').value=b.textContent;$('#chat-form').requestSubmit()});\\nasync function refresh(){if(busy)return;busy=true;$('#refresh').disabled=true;const tasks=[loadMarkets(),loadChart(),loadFlows(),loadHoldings()];const results=await Promise.allSettled(tasks);results.forEach((r,i)=>{if(r.status==='rejected'){const targets=['#markets','#chart-note','#flow-note','#holdings-note'];$(targets[i]).textContent='조회 실패: '+r.reason.message}});$('#clock').textContent=time(new Date().toISOString());busy=false;$('#refresh').disabled=false}\\n$('#refresh').onclick=refresh;refresh();setInterval(refresh,60000);window.addEventListener('resize',()=>['price-chart','flow-chart'].forEach(id=>{if(document.getElementById(id).data)Plotly.Plots.resize(id)}));\\nEOF\"]" cwd=/workspace/toss http.span=1102266 role=server
